name: PPOB Topup Digiflazz
on:
  schedule:
    - cron: "*/8 * * * *"
  workflow_dispatch:
jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Panggil endpoint topup digiflazz
        run: |
          response=$(curl -s -o /tmp/response.json -w "%{http_code}" \
            --max-time 90 \
            -X GET "https://creatonomy.id/api/cron/wallet-topup-digiflazz" \
            -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}")
          echo "HTTP Status: $response"
          cat /tmp/response.json
          if [ "$response" -ne 200 ]; then
            echo "Sync gagal dengan status $response"
            exit 1
          fi
